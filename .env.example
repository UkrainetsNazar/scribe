APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false

# Required (at least 32 characters). Add it with:
#   printf '\nJWT_SECRET=%s\n' "$(openssl rand -hex 32)" >> .env

# Addresses for running the app or the tests on the host (docker compose has its own)
DATABASE_URL=postgresql+asyncpg://scribe:scribe@localhost:5433/scribe
MONGO_URL=mongodb://localhost:27017
MONGO_DB=scribe
REDIS_URL=redis://localhost:6380/0
RABBITMQ_URL=amqp://scribe:scribe@localhost:5672/
MINIO_ENDPOINT=localhost:9100
MINIO_PUBLIC_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=scribe
MINIO_SECRET_KEY=scribe-secret
FFPROBE_BIN=ffprobe

# Local webhook experiments only (the receiver runs on your machine, scripts/webhook_receiver.py):
# WEBHOOK_ALLOW_PRIVATE_NETWORKS=true

# stub: placeholder transcripts, no model. whisper: real speech recognition, which also needs
# WORKER_EXTRAS="--extra whisper" (the worker image is then built with faster-whisper).
TRANSCRIBER=stub
WORKER_EXTRAS=
WHISPER_MODEL=small
